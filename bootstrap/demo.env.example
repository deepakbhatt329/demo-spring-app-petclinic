# Copy to bootstrap/demo.env and fill in real values.
# Loaded by setup.sh -> kubectl create secret generic harness-idp-secrets --from-env-file=bootstrap/demo.env
# Never commit bootstrap/demo.env (already in .gitignore).

# --- Harness dev SaaS (M2) ---
HARNESS_IM_URL=https://qa.harness.io
HARNESS_ACCOUNT_ID=REPLACE_ME
HARNESS_API_KEY=pat.REPLACE_ME

# --- Custom Integration IDs from Harness dev UI (M3) ---
IID_BUILD=REPLACE_ME
IID_DEPLOYMENT=REPLACE_ME
IID_QUALITY=REPLACE_ME
IID_SECURITY=REPLACE_ME
IID_CUSTOM=REPLACE_ME
# Full webhook URL for the incidents integration (from M3 #6 webhook_endpoints_per_kind.incidents)
IID_INCIDENTS_WEBHOOK_URL=REPLACE_ME

# --- SonarCloud (M4) ---
SONAR_TOKEN=REPLACE_ME
SONAR_PROJECT_KEY=deepakbhatt329_demo-spring-app-petclinic
SONAR_ORGANIZATION=deepakbhatt329

# --- PagerDuty (M5) ---
PAGERDUTY_ROUTING_KEY=REPLACE_ME

# --- GHCR image push credentials ---
GHCR_USERNAME=deepakbhatt329
GHCR_TOKEN=ghp_REPLACE_ME

# --- IDP entity that all ingested records attach to ---
IDP_ENTITY_REF=component:account/petclinicdemo
